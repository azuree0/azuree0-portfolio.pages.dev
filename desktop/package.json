{
  "name": "azure-portfolio",
  "version": "0.1.0",
  "description": "Azure Portfolio — Electron desktop shell for Trunk/Yew WASM",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "premake": "cd .. && NO_COLOR=false trunk build --release --config Trunk.desktop.toml",
    "prestart": "npm run premake",
    "start": "electron-forge start",
    "make": "electron-forge make",
    "package": "electron-forge package"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-snap": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@reforged/maker-appimage": "^5.3.1",
    "electron": "^35.7.5"
  }
}
