{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "backend",
    "outDir": "backend",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": ["backend/**/*.ts", "backend/**/*.d.ts"],
  "exclude": ["backend/**/*.js"]
}
